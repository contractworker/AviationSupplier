@using AviationSupplier.Web.ViewModel;
@model SupplierViewModel

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-12 p-0">

            <div class="card shadow-sm mb-3">

                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Add Supplier</h4>
                </div>

                <div class="card-body">

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" asp-action="Save" asp-controller="Supplier">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- LINE 1 -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Supplier Name *</label>
                                <input asp-for="Name" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Website *</label>
                                <input asp-for="Website" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" />
                            </div>
                        </div>

                        <!-- LINE 2 -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Mobile</label>
                                <input asp-for="Mobile" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">OEM</label>
                                <input asp-for="OEM" class="form-control" />
                            </div>
                        </div>

                        <!-- LINE 3 -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Address 1</label>
                                <input asp-for="Address1" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Address 2</label>
                                <input asp-for="Address2" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                            </div>
                        </div>

                        <!-- LINE 4 -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Post Code</label>
                                <input asp-for="PostCode" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Country *</label>
                                <select asp-for="CountryId"
                                        class="form-select"
                                        asp-items="@(new SelectList(Model.CountryViewModels, "CountryId", "CountryName"))">
                                    <option value="">-- Select --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Status</label>
                                <input asp-for="StatusId" class="form-control" />
                            </div>
                        </div>

                        <!-- LINE 5 -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Username</label>
                                <input asp-for="Username" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Note</label>
                                <input asp-for="Note" class="form-control" />
                            </div>
                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2 mb-3">

                            <input type="hidden" asp-for="Id" />

                            <a href="/Supplier" class="btn btn-secondary">Cancel</a>

                            <button type="reset" class="btn btn-primary">Reset</button>

                            <button type="submit" class="btn btn-primary">
                                Save Supplier
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>